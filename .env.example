PORT=4173
APP_BASE_URL=http://localhost:4173

# Optional. Generated into data/secrets.json when omitted.
# SESSION_SECRET=
# CREDENTIALS_KEY=

# Cursor live agents. Without this key the room uses Draft sections.
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5
# CURSOR_RUNTIME=local
# CURSOR_REPO=

# Atlassian OAuth app (3LO). Redirect URI: {APP_BASE_URL}/auth/atlassian/callback
# Create at https://developer.atlassian.com/console/myapps/
# Confluence: read:page:confluence, write:comment:confluence
# Jira: read:jira-work, read:jira-user, write:jira-work (creates/comments on Approve)
# After adding scopes, Disconnect and Connect Atlassian again.
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=

# Figma OAuth app. Redirect URI: {APP_BASE_URL}/auth/figma/callback
# Create at https://www.figma.com/developers/apps
# Scopes: current_user:read, file_metadata:read, file_content:read, file_comments:write
# After adding scopes, Disconnect and Connect Figma again.
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# GitHub OAuth app. Callback URL: {APP_BASE_URL}/auth/github/callback
# Create at https://github.com/settings/developers → OAuth Apps
# Scopes: read:user, repo (PR create on Approve)
# After adding repo scope, Disconnect and Connect GitHub again.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Jenkins (trigger on Approve write for Deploy). Job path may be folder/job.
# JENKINS_BASE_URL=https://jenkins.example.com
# JENKINS_USER=
# JENKINS_API_TOKEN=
# JENKINS_DEFAULT_JOB=order-status-deploy
# Shared secret Jenkins uses when calling POST /api/jenkins/smoke
# JENKINS_SMOKE_TOKEN=
# Optional default API probe path for smoke (relative to Deploy URL)
# SMOKE_PROBE_PATH=/orders/smoke-order/payment-status

# QA E2E on agent host (never paste into chat). Optional Playwright: npm i -D playwright && npx playwright install chromium
# QA_TEST_USER=
# QA_TEST_PASSWORD=
# QA_LOGIN_PATH=/login

# Optional DevOps log/health probe URL (GET)
# DEVOPS_LOG_PROBE_URL=
